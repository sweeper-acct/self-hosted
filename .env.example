# ─── Sweeper Self-Hosted — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in all required values.
# Required fields are marked [REQUIRED]. Others have sensible defaults.
#
# Get your Sweeper MCP API key at: https://enterprise.sweeper-acct.com.au

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── URLs ─────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://sweeper.firm.com.au
FRONTEND_URL=https://sweeper.firm.com.au
CORS_ORIGINS=https://sweeper.firm.com.au

# ─── Sweeper MCP API ──────────────────────────────────────────────────────────
SWEEPER_MCP_KEY=sk-swp-...
SWEEPER_MCP_ENDPOINT=https://enterprise.sweeper-acct.com.au

# ─── Version ─────────────────────────────────────────────────────────────────
# Set this to pin to a specific release. docker compose pull fetches the tag.
SWEEPER_VERSION=1.0.0

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Sweeper
VITE_APP_NAME=Sweeper
ENVIRONMENT=production

# ─── Optional: BYOK ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=

# ─── Optional: email ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Optional: error monitoring ──────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=

# ─── Optional: ports ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── Optional: contact email ─────────────────────────────────────────────────
VITE_CONTACT_EMAIL=service@sweeper-acct.com.au
