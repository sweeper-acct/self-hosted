# ─── Sweeper Self-Hosted — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in all required values.
# Get your Sweeper MCP API key at: https://enterprise.sweeper-acct.com.au

# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── MCP API key (from enterprise.sweeper-acct.com.au) ───────────────────────
# Used by the frontend to call Sweeper's AI Normalization API and to display
# your license plan and quota on the Plan & Billing page.
SWEEPER_MCP_KEY=sk-swp-

# ─── Deployment mode ─────────────────────────────────────────────────────────
# Required: activates the self-hosted UI (billing page, onboarding flow).
VITE_DEPLOYMENT_MODE=self-hosted

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Sweeper
VITE_CONTACT_EMAIL=service@sweeper-acct.com.au

# ─── Version ──────────────────────────────────────────────────────────────────
# Pin to a specific release. docker compose pull fetches this tag.
SWEEPER_VERSION=1.0.26

# ─── Optional: frontend port ──────────────────────────────────────────────────
FRONTEND_PORT=3000
