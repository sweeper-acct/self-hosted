# Sweeper Self-Hosted — Environment Variables
# Copy this file to .env and fill in every required value.
# Lines starting with # are comments — do not uncomment blank values.

# ─── Required: Supabase ────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Supabase anon/public key — used by the frontend
SUPABASE_ANON_KEY=

# Supabase service_role key — used by the backend (keep this secret)
SUPABASE_SERVICE_KEY=

# ─── Required: Frontend build ──────────────────────────────────────────────────
# These are baked into the frontend bundle at build time (docker compose build frontend).
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are the same values as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL of the backend API — accessible from the browser
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Sweeper

# ─── Required: Sweeper MCP ─────────────────────────────────────────────────────
# Your MCP API key from enterprise.sweeper-acct.com.au
# Format: sk-swp-...
SWEEPER_MCP_KEY=

# MCP server endpoint (do not change unless directed by Sweeper support)
SWEEPER_MCP_ENDPOINT=https://sweeper-acct.com.au/api/v1

# ─── Optional: AI Classification (BYOK) ───────────────────────────────────────
# Only needed if NOT using SWEEPER_MCP_KEY.
# When SWEEPER_MCP_KEY is set, GST classification runs on Sweeper's infrastructure —
# no Anthropic key required on your server.
ANTHROPIC_API_KEY=

# LLM model (default is Haiku — fast and cost-effective for GST classification)
BAS_AGENT_MODEL=claude-haiku-4-5-20251001

# ─── Required: Supabase Auth ───────────────────────────────────────────────────
# JWT secret — must match the JWT secret in your Supabase project (Settings → API)
SUPABASE_JWT_SECRET=

# ─── Required: App ─────────────────────────────────────────────────────────────
APP_NAME=Sweeper
ENVIRONMENT=production

# Public URL of your frontend (used for Supabase Auth redirects)
# Example: https://sweeper.yourdomain.com.au
FRONTEND_URL=

# CORS — set to your frontend URL (can be comma-separated for multiple origins)
CORS_ORIGINS=

# ─── Optional: Orvexa (Bank Statement Extraction) ──────────────────────────────
# If left blank, a stub extractor is used (good for testing; not for production)
ORVEXA_API_KEY=

# ─── Optional: Ports ───────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── Optional: Encryption (for BYOK key storage) ──────────────────────────────
# 32-byte base64 key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Optional: Sentry (error monitoring) ──────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=

# ─── Optional: Stripe (in-app billing — leave blank if not using) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Optional: Resend (transactional email) ───────────────────────────────────
RESEND_API_KEY=
