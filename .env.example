# ─── Sweeper Self-Hosted — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in all required values.
# Get your Sweeper MCP API key at: https://enterprise.sweeper-acct.com.au

# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── API endpoint (Sweeper CORS gateway — same for all self-hosted customers) ───
# Your deployment domain must be registered at enterprise.sweeper-acct.com.au
# to be authorised through this gateway.
VITE_API_BASE_URL=https://gateway.enterprise.sweeper-acct.com.au

# ─── Deployment mode ─────────────────────────────────────────────────────────
# Required: tells the frontend to route API calls through the Sweeper CORS gateway
# and to send customer Supabase credentials with every request.
VITE_DEPLOYMENT_MODE=self-hosted

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Sweeper
VITE_CONTACT_EMAIL=service@sweeper-acct.com.au

# ─── Version ──────────────────────────────────────────────────────────────────
# Pin to a specific release. docker compose pull fetches this tag.
SWEEPER_VERSION=1.0.7

# ─── Optional: frontend port ──────────────────────────────────────────────────
FRONTEND_PORT=3000
