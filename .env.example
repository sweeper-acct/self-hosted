# ─── Sweeper Self-Hosted — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in all required values.
# Get your Sweeper MCP API key at: https://enterprise.sweeper-acct.com.au

# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── API endpoint (Sweeper backend — provided with your MCP key) ───────────────
VITE_API_BASE_URL=https://api.sweeper-acct.com.au

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Sweeper
VITE_CONTACT_EMAIL=service@sweeper-acct.com.au

# ─── Version ──────────────────────────────────────────────────────────────────
# Pin to a specific release. docker compose pull fetches this tag.
SWEEPER_VERSION=1.0.6

# ─── Optional: frontend port ──────────────────────────────────────────────────
FRONTEND_PORT=3000
